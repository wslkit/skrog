* text=auto
*.sh text eol=lf
*.go text eol=lf

# Anything the Linux side sources or executes must be LF, even without a .sh
# extension: a CRLF versions.env breaks `. versions.env` in bash with
# "$'\r': command not found", which only shows up outside CI.
versions.env text eol=lf
*.Dockerfile text eol=lf
.githooks/* text eol=lf

# Same trap, same reason: a CRLF completion script fails in bash with
# "$'\r': command not found" the moment it is sourced, and only for people who
# cloned on Windows -- which is everyone here.
*.bash text eol=lf

# binfmt_misc registration lines, written byte-for-byte into
# /proc/sys/fs/binfmt_misc/register (#462). The kernel parses the line by
# splitting on ':' and takes the last field as the flags -- so a trailing \r
# becomes part of the flags, and the register write fails with EINVAL for a
# reason that names nothing. Same class as the versions.env trap above, with
# a worse error message.
*.reg text eol=lf

# Captured kernel and engine output used as test fixtures (#511). A checkout
# that rewrites them to CRLF changes the bytes a test edits with
# strings.Replace, and the edit silently stops matching -- which is how
# vmtop's fixture failed only on CI. The parser's own CRLF handling has its
# own test; the fixture stays byte-for-byte what the machine printed.
internal/vmtop/testdata/* -text
