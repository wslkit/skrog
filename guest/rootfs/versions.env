# Pinned inputs for the Skrog rootfs. Nothing here is ever "latest" —
# every bump is a reviewed commit, and these values land in the release manifest.

ALPINE_BRANCH=v3.24
ALPINE_ROOTFS_VERSION=3.24.1
ALPINE_ROOTFS_SHA256=auto   # verified against Alpine's published .sha256 at build time

# Engine components, built from source (git tags in their upstream repos).
# ENGINE_VERSION is the user-facing number; MOBY_TAG is moby's own tag spelling.
ENGINE_VERSION=29.8.1
MOBY_TAG=docker-v29.8.1
CONTAINERD_VERSION=v2.1.4
RUNC_VERSION=v1.3.0
BUILDKIT_VERSION=v0.27.0

# Expected commit each tag must resolve to (#88): a git tag can be moved and a
# source repo compromised, and the result becomes root inside every user's
# engine VM. build-engine.sh fails the build on mismatch. Bump a *_SHA in the
# same commit as its *_VERSION; discover a new value by running the build with
# the SHA blank, which logs the resolved commit instead of failing.
MOBY_SHA=464cd50c3d9e92877d56940ea160de6fca7bea23
CONTAINERD_SHA=75cb2b7193e4e490e9fbdc236c0e811ccaba3376
RUNC_SHA=4ca628d1d4c974f92d24daccb901aa078aad748e
BUILDKIT_SHA=2bcd66daa720bd45da2a43db59cd3e8ddf3f39ae

# nvidia-cdi-hook (#139): the one glibc binary in the rootfs. Its presence when
# dockerd starts is what makes moby route `docker run --gpus all` to the CDI
# spec `skrog enable-gpu` installs; the spec is hookless, so the binary is
# never executed for injection — it only has to exist and start. It cannot be
# built on musl (go-nvml's dlopen shim uses glibc-only RTLD flags), so build.sh
# builds it static-glibc in the pinned golang Debian image. Tag + commit pinned
# like every other component (#88).
NVIDIA_CDI_HOOK_VERSION=v1.20.0
NVIDIA_CDI_HOOK_SHA=5505e2f94d9aaa08561490db974ba3cd676af209

# The Alpine base, pinned by digest (#88) so a re-pushed 3.24 tag cannot change
# the userland. ALPINE_BRANCH stays the human-readable branch for the SBOM.
ALPINE_DIGEST=sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# The component combination above is what the acceptance suite validates.
# Newer tags exist upstream; bumping one means re-running acceptance, because
# "engine upgrade refuses combinations outside the tested matrix" (PLAN §04).

# Toolchain used to build them; bumping this changes output, so it is pinned too.
# Floor is set by moby's go.mod (docker-v29.8.0 requires >= 1.26.3).
GO_VERSION=1.26.7

# Packaging revision of the rootfs itself. The tarball carries more than the
# engine (the skrog-agent, config, Alpine userland), so it can change while
# ENGINE_VERSION stays put; the artifact version is ENGINE_VERSION-REVISION,
# Debian-style. Bump this when rootfs contents change without an engine bump;
# reset to 1 on an engine bump. (The first 29.7.2 release predates the scheme
# and is tagged bare, as rootfs-v29.7.2.)
ROOTFS_REVISION=1

# Bump to force CI to recompile the engine even when nothing above changed —
# the escape hatch for a poisoned cache or a change to build.sh's docker
# invocation, which the cache key deliberately does not cover.
CACHE_EPOCH=1
