# Pinned inputs for the Windows arm64 docker CLI (#450).
#
# Upstream publishes no Windows arm64 docker.exe -- download.docker.com's
# static tree has exactly one directory, x86_64/, and docker/cli publishes no
# release assets at all. So on Windows on ARM `skrog cli install` laid down
# compose, buildx and the credential helper, all of which DO have arm64
# builds, and skipped the one command anybody types.
#
# This builds it. amd64 is NOT built here and stays Docker's own published
# binary; see third_party/docker-cli/build.sh for why the asymmetry is
# deliberate rather than an omission.

# The CLI version, which must match the `docker` component in
# internal/dockercli/manifest.json -- the same binary is installed on both
# architectures and reporting two different versions would be a support
# nightmare. A test pins the two together.
DOCKER_CLI_VERSION=29.8.1
DOCKER_CLI_TAG=v29.8.1

# The commit the tag must resolve to (#88). A git tag can be moved and a
# source repository compromised, and the result is the binary every docker
# command on the machine runs. build.sh fails on a mismatch.
#
# This is the tag's dereferenced commit (refs/tags/<tag>^{}), not the tag
# object's own hash.
DOCKER_CLI_SHA=4a63305d74332de5ceba7fcbccbc3cbb7412f5ba

# Toolchain. Bumping this changes the output, so it is pinned like everything
# else. Kept in step with guest/rootfs/versions.env so the engine and the CLI
# are built by the same compiler.
GO_VERSION=1.26.7
